# calcwise.by — конфигурация сервера (Apache/LiteSpeed). nginx этот файл не читает.
# Копируется в корень сборки вместе с остальным содержимым public/.
#
# Настроено: скрытие служебных файлов, http → https и www → без www, страница 404,
# заголовки безопасности, кэширование, сжатие.
#
# Проверка после деплоя:
#   curl -I http://calcwise.by/            → 301 на https://calcwise.by/
#   curl -I https://www.calcwise.by/       → 301 на https://calcwise.by/
#   curl -I https://calcwise.by/nope/      → 404

Options -Indexes
ServerSignature Off
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Всё, что начинается с точки, наружу не отдаём (.git, .env); .well-known нужен для сертификата
  RewriteRule (^|/)\.(?!well-known/) - [F,L]

  # http → https, www → без www: один переход
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://calcwise.by/$1 [R=301,L]

  # Адреса без завершающего слеша → со слешем (сайт собран в build.format: 'directory')
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
  RewriteRule ^(.*)$ https://calcwise.by/$1/ [R=301,L]
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Хешированные ассеты Astro неизменяемы
  <FilesMatch "\.(css|js|woff2|png|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>
