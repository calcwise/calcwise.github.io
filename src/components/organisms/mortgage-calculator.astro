---
/*
 * Калькулятор ипотеки: форма, шапка результатов, таблица графика (главный блок),
 * эффект досрочек и аналитика. Динамику рисует lib/calculator-ui.ts; стартовое
 * состояние — в data-initial.
 */
import Legend from '@/components/molecules/legend.astro';
import Analysis from '@/components/organisms/analysis.astro';
import CalculatorForm from '@/components/organisms/calculator-form.astro';
import ResultsSummary from '@/components/organisms/results-summary.astro';
import ScheduleTable from '@/components/organisms/schedule-table.astro';
import { buildSchedule } from '@/lib/mortgage';
import { rowsCountText } from '@/lib/schedule-render';
import type { CalculatorState } from '@/lib/url-state';

interface Props {
  initial: CalculatorState;
  /** Страница задаёт свой пресет: сохранённое в браузере состояние не применяется */
  preset?: boolean;
}
const { initial, preset = false } = Astro.props;

/* Результаты для стартового состояния считаются при сборке: страница приходит
   уже с цифрами и таблицей, скрипт лишь подхватывает форму. Без прыжков макета
   и с осмысленным содержимым без JavaScript. */
const result = buildSchedule(initial);
---

<section
  class="calc"
  data-calc
  data-initial={JSON.stringify(initial)}
  data-preset={preset ? '1' : '0'}
>
  <CalculatorForm />

  <p class="calc__empty" data-empty hidden>Исправьте значения в форме, чтобы увидеть график.</p>

  <div class="results" data-results>
    <ResultsSummary initial={initial} result={result} />

    <section class="results__schedule" aria-labelledby="schedule-heading">
      <div class="results__row">
        <h2 class="results__heading" id="schedule-heading">График платежей</h2>
        <span class="results__count" data-out="rows-count">{rowsCountText(result)}</span>
      </div>
      <ScheduleTable result={result} />
      <Legend
        items={[
          { tone: 'principal', label: 'основной долг' },
          { tone: 'interest', label: 'проценты' },
          { tone: 'grace', label: 'отсрочка', out: 'legend-grace', hidden: true },
          { tone: 'prepay', label: 'досрочное погашение', out: 'legend-prepay', hidden: true },
        ]}
      />
    </section>

    <div class="results__effect" data-out="effect" hidden></div>

    <Analysis initial={initial} result={result} />
  </div>
</section>

<script>
  import { initCalculator } from '@/lib/calculator-ui';
  document.querySelectorAll<HTMLElement>('[data-calc]').forEach(initCalculator);
</script>

<style>
  .calc {
    display: grid;
    gap: var(--space-6);
  }

  .calc__empty {
    color: var(--color-text-muted);
    padding: var(--space-7) var(--space-4);
    text-align: center;
    border-radius: var(--radius-md);
    background: var(--color-paper-2);
  }

  .results {
    display: grid;
    gap: var(--space-7);
    min-width: 0;
  }

  .results__schedule {
    display: grid;
    gap: var(--space-3);
    min-width: 0;
  }

  .results__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .results__count {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media print {
    .results {
      gap: var(--space-5);
    }
  }
</style>
