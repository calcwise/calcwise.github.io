---
import Container from '@/components/atoms/container.astro';
import Logo from '@/components/atoms/logo.astro';
import { isCurrentPath, navItems, normalizePath } from '@/lib/menu';

const currentPath = normalizePath(Astro.url.pathname);
---

<header class="header no-print">
  <Container class="header__inner">
    <a class="header__logo" href="/" aria-label="Amortize — на главную">
      <Logo />
    </a>
    {/* Меню шапки — для широких экранов; на узких его место занимает нижний таб-бар */}
    <nav class="header__nav" aria-label="Основная навигация">
      <ul class="header__list">
        {
          navItems.map((item) => (
            <li>
              <a
                class="header__link"
                href={item.href}
                aria-current={isCurrentPath(item.href, currentPath) ? 'page' : undefined}
              >
                {item.label}
                {item.soon && <span class="header__soon">скоро</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </Container>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-rule);
    padding-top: var(--safe-top);
  }

  .header :global(.header__inner) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: var(--header-height);
  }

  .header__logo {
    display: inline-flex;
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .header__nav {
    display: none;
  }

  .header__list {
    display: flex;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
  }

  .header__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: 0 var(--space-4);
    border-radius: var(--radius-md);
    text-decoration: none;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .header__link:hover {
    color: var(--color-text);
    background: var(--color-paper-2);
  }

  .header__link[aria-current='page'] {
    color: var(--color-text);
    font-weight: 600;
    box-shadow: inset 0 -2px 0 var(--color-ink);
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  }

  .header__soon {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-text-muted);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-full);
    padding: 0 var(--space-2);
    line-height: 1.4;
  }

  @media (min-width: 1024px) {
    .header__nav {
      display: block;
    }
  }
</style>
