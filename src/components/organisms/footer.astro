---
import Container from '@/components/atoms/container.astro';
import Logo from '@/components/atoms/logo.astro';
import { siteConfig } from '@/config/site';

const year = new Date().getFullYear();
const since = siteConfig.since === year ? String(year) : `${siteConfig.since}–${year}`;
---

<footer class="footer no-print">
  <Container class="footer__inner">
    <div class="footer__brand">
      <Logo />
      <p class="footer__tagline">{siteConfig.tagline}</p>
      <p class="footer__disclaimer">
        Расчёт справочный. Условия конкретного банка — порядок начисления процентов, даты платежей,
        комиссии и страховки — могут отличаться, итоговые цифры уточняйте в договоре.
      </p>
    </div>
    <div class="footer__navs">
      <nav class="footer__nav" aria-label="Ипотека">
        <h2 class="footer__heading">Ипотека</h2>
        <ul class="footer__list">
          <li><a href="/mortgage/">Калькулятор ипотеки</a></li>
          <li><a href="/mortgage/annuity/">Аннуитетные платежи</a></li>
          <li><a href="/mortgage/differentiated/">Дифференцированные платежи</a></li>
        </ul>
      </nav>
      <nav class="footer__nav" aria-label="Кооператив">
        <h2 class="footer__heading">Кооператив</h2>
        <ul class="footer__list">
          <li><a href="/cooperative/">Калькулятор кооператива</a></li>
        </ul>
      </nav>
      <nav class="footer__nav" aria-label="Справка">
        <h2 class="footer__heading">Справка</h2>
        <ul class="footer__list">
          <li><a href="/guide/">Как мы считаем</a></li>
          <li><a href="/guide/faq/">Вопросы и ответы</a></li>
        </ul>
      </nav>
    </div>
  </Container>
  <Container class="footer__bottom">
    <p>© {since} {siteConfig.name}. Бесплатный сервис без рекламы банков.</p>
  </Container>
</footer>

<style>
  .footer {
    background: var(--color-paper);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* Бренд слева одной колонкой, три раздела навигации справа в ряд */
  .footer :global(.footer__inner) {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-7) var(--space-5);
  }

  .footer__navs {
    display: grid;
    gap: var(--space-6);
  }

  .footer__tagline {
    margin-top: var(--space-3);
    max-width: 36ch;
    color: var(--color-text);
  }

  .footer__disclaimer {
    margin-top: var(--space-3);
    max-width: 52ch;
    font-size: var(--text-xs);
  }

  .footer__heading {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }

  .footer__list {
    list-style: none;
    padding: 0;
    display: grid;
  }

  /* Ссылка — цель нажатия высотой --tap-min при обычном межстрочном интервале */
  .footer__list a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    text-decoration: none;
    transition: var(--transition-ui);
  }

  .footer__list a:hover {
    color: var(--color-ink);
    text-decoration: underline;
  }

  .footer :global(.footer__bottom) {
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-rule);
    font-size: var(--text-xs);
  }

  @media (min-width: 768px) {
    .footer__navs {
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }
  }

  /* От 1024px разделы справа по ширине содержимого, ссылки в одну строку; бренду — остальное */
  @media (min-width: 1024px) {
    .footer :global(.footer__inner) {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-7);
    }

    .footer__navs {
      grid-auto-columns: max-content;
    }

    .footer__list a {
      white-space: nowrap;
    }
  }
</style>
