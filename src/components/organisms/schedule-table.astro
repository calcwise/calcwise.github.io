---
/* Таблица графика платежей. Стартовые строки — при сборке, пересчёт — lib/schedule-render.ts */
import { fmtMoney } from '@/lib/format';
import type { ScheduleResult } from '@/lib/mortgage';
import { scheduleRowsHtml } from '@/lib/schedule-render';

interface Props {
  /** Ограничить высоту и прокручивать внутри (страница калькулятора) */
  scroll?: boolean;
  /** Результат для стартовых строк; без него таблица пустая до расчёта скриптом */
  result?: ScheduleResult;
  /** Введённая дополнительная переплата: нулевая строка и итог */
  extra?: number;
}
const { scroll = true, result, extra = 0 } = Astro.props;
const hasRates = (result?.input.rates.length ?? 0) > 1;
const hasPrepay = (result?.summary.totalPrepaid ?? 0) > 0;
---

<div class:list={['table-wrap', { 'table-wrap--tall': scroll }]}>
  <table class="table table--schedule">
    <thead>
      <tr>
        <th scope="col">№</th>
        <th scope="col" data-col="rate" hidden={!hasRates}>Ставка</th>
        <th scope="col">Платёж</th>
        <th scope="col">Основной долг</th>
        <th scope="col">Проценты</th>
        <th scope="col" data-col="prepayment" hidden={!hasPrepay}>Досрочно</th>
        <th scope="col">Остаток долга</th>
        <th scope="col">Выплачено всего</th>
        <th scope="col">Выплачено процентов</th>
        <th scope="col">Осталось выплатить</th>
      </tr>
    </thead>
    <tbody data-out="schedule-body" set:html={result ? scheduleRowsHtml(result, extra) : ''} />
    <tfoot>
      <tr>
        <th scope="row">Итого</th>
        <td data-col="rate" hidden={!hasRates}></td>
        <td class="num" data-out="foot-paid"
          >{result && fmtMoney(Math.round((result.summary.totalPaid + extra) * 100) / 100)}</td
        >
        <td class="num cell--principal" data-out="foot-principal"
          >{result && fmtMoney(result.summary.totalPrincipal)}</td
        >
        <td class="num cell--interest" data-out="foot-interest"
          >{result && fmtMoney(result.summary.totalInterest)}</td
        >
        <td
          class="num cell--prepay"
          data-col="prepayment"
          data-out="foot-prepay"
          hidden={!hasPrepay}>{hasPrepay && result && fmtMoney(result.summary.totalPrepaid)}</td
        >
        <td></td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
    </tfoot>
  </table>
</div>
