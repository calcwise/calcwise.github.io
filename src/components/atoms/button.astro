---
interface Props {
  href?: string;
  type?: 'button' | 'submit';
  variant?: 'solid' | 'outline' | 'ghost';
  size?: 'md' | 'lg';
  class?: string;
  [key: `data-${string}`]: string | undefined;
}
const {
  href,
  type = 'button',
  variant = 'solid',
  size = 'md',
  class: className,
  ...rest
} = Astro.props;
const classes = ['button', `button--${variant}`, `button--${size}`, className];
---

{
  href ? (
    <a class:list={classes} href={href} {...rest}>
      <slot />
    </a>
  ) : (
    <button class:list={classes} type={type} {...rest}>
      <slot />
    </button>
  )
}

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: var(--control-height);
    padding: 0 var(--space-5);
    border-radius: var(--radius-md);
    border: 0;
    font-weight: 600;
    font-size: var(--text-sm);
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    transition: var(--transition-ui);
  }

  .button--lg {
    min-height: calc(var(--control-height) + var(--space-2));
    padding: 0 var(--space-6);
    font-size: var(--text-base);
  }

  .button--solid {
    background: var(--color-ink-solid);
    color: var(--color-on-ink);
  }

  .button--solid:hover {
    background: var(--color-ink-solid-hover);
  }

  /* Вторичная кнопка: тональная заливка чернилами вместо обводки */
  .button--outline {
    background: var(--color-ink-soft);
    color: var(--color-ink);
  }

  .button--outline:hover {
    background: var(--color-ink-soft-hover);
  }

  .button--ghost {
    background: transparent;
    color: var(--color-ink);
    padding-inline: var(--space-3);
  }

  .button--ghost:hover {
    background: var(--color-ink-soft);
  }
</style>
