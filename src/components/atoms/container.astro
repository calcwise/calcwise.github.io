---
interface Props {
  class?: string;
  /** Узкая колонка для текста: не шире меры строки */
  narrow?: boolean;
}
const { class: className, narrow = false } = Astro.props;
---

<div class:list={['container', { 'container--narrow': narrow }, className]}>
  <slot />
</div>

<style>
  .container {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: calc(var(--container-pad) + var(--safe-left))
      calc(var(--container-pad) + var(--safe-right));
  }

  .container--narrow {
    max-width: calc(var(--measure) + 2 * var(--container-pad));
  }
</style>
