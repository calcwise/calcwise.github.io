---
import BaseLayout from '@/components/templates/base-layout.astro';
import Button from '@/components/atoms/button.astro';
import Container from '@/components/atoms/container.astro';
import Figure from '@/components/molecules/figure.astro';
import Legend from '@/components/molecules/legend.astro';
import StatList from '@/components/molecules/stat-list.astro';
import YearsTable from '@/components/molecules/years-table.astro';
import ScheduleTable from '@/components/organisms/schedule-table.astro';
import { siteConfig } from '@/config/site';
import { breadcrumbsJsonLd } from '@/lib/seo';

const path = '/mortgage/schedule/';
const title = 'График платежей по кредиту';
const description =
  'Полный график платежей по месяцам: платёж, основной долг, проценты, остаток и выплачено нарастающим итогом. Параметры кредита берутся из ссылки на расчёт.';
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  jsonLd={[
    breadcrumbsJsonLd(siteConfig.siteUrl, [
      { name: 'Главная', path: '/' },
      { name: 'Ипотека', path: '/mortgage/' },
      { name: 'График платежей', path },
    ]),
  ]}
>
  <Container>
    <section class="schedule-page" data-schedule-page>
      <p class="schedule-page__error" data-error hidden></p>
      <div class="schedule-page__content" data-content hidden>
        <header class="schedule-page__head">
          <div class="schedule-page__titles">
            <h1 class="schedule-page__title">График платежей</h1>
            <p class="schedule-page__conditions num" data-out="conditions"></p>
          </div>
          <div class="schedule-page__actions no-print">
            <Button variant="ghost" data-action="csv">Скачать CSV</Button>
            <Button variant="ghost" data-action="print">Печать</Button>
          </div>
        </header>

        <div class="schedule-page__summary">
          <Figure label="Ежемесячный платёж" />
          <StatList inline out="stats" />
        </div>

        <div class="schedule-page__table">
          <ScheduleTable scroll={false} />
          <Legend
            items={[
              { tone: 'principal', label: 'основной долг' },
              { tone: 'interest', label: 'проценты' },
              { tone: 'grace', label: 'отсрочка', out: 'legend-grace', hidden: true },
              { tone: 'prepay', label: 'досрочное погашение', out: 'legend-prepay', hidden: true },
            ]}
          />
        </div>

        <section class="schedule-page__years" aria-labelledby="years-heading">
          <h2 class="schedule-page__subheading" id="years-heading">Итоги по годам</h2>
          <YearsTable />
        </section>
      </div>
    </section>
  </Container>
</BaseLayout>

<script>
  import { initSchedulePage } from '@/lib/schedule-ui';
  document.querySelectorAll<HTMLElement>('[data-schedule-page]').forEach(initSchedulePage);
</script>

<style>
  .schedule-page__content {
    display: grid;
    gap: var(--space-7);
  }

  .schedule-page__head {
    display: grid;
    gap: var(--space-4);
  }

  .schedule-page__titles {
    display: grid;
    gap: var(--space-2);
  }

  .schedule-page__title {
    font-size: var(--text-2xl);
  }

  .schedule-page__conditions {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* Кнопки: на телефоне столбиком во всю ширину, от 480px — в ряд */
  .schedule-page__actions {
    display: grid;
    gap: var(--space-2);
  }

  .schedule-page__summary {
    display: grid;
    gap: var(--space-5);
    align-items: start;
  }

  .schedule-page__table,
  .schedule-page__years {
    display: grid;
    gap: var(--space-3);
  }

  .schedule-page__error {
    padding: var(--space-5);
    border-radius: var(--radius-md);
    background: var(--color-danger-soft);
    color: var(--color-danger);
  }

  .schedule-page__subheading {
    font-size: var(--text-xl);
  }

  @media (min-width: 480px) {
    .schedule-page__actions {
      grid-auto-flow: column;
      justify-content: start;
    }
  }

  @media (min-width: 768px) {
    .schedule-page__summary {
      grid-template-columns: auto minmax(0, 1fr);
    }
  }

  /* Кнопки справа от заголовка только там, где заголовок не переносится из-за них */
  @media (min-width: 1024px) {
    .schedule-page__head {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
    }
  }
</style>
