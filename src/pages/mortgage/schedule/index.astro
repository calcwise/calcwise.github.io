---
import BaseLayout from '@/components/templates/base-layout.astro';
import Button from '@/components/atoms/button.astro';
import Container from '@/components/atoms/container.astro';
import ScheduleTable from '@/components/organisms/schedule-table.astro';
import { siteConfig } from '@/config/site';
import { breadcrumbsJsonLd } from '@/lib/seo';

const path = '/mortgage/schedule/';
const title = 'График платежей по кредиту';
const description =
  'Полный график платежей по месяцам: платёж, основной долг, проценты, остаток и выплачено нарастающим итогом. Параметры кредита берутся из ссылки на расчёт.';
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  jsonLd={[
    breadcrumbsJsonLd(siteConfig.siteUrl, [
      { name: 'Главная', path: '/' },
      { name: 'Ипотека', path: '/mortgage/' },
      { name: 'График платежей', path },
    ]),
  ]}
>
  <Container>
    <section class="schedule-page" data-schedule-page>
      <p class="schedule-page__error" data-error hidden></p>
      <div class="schedule-page__content" data-content hidden>
        <header class="schedule-page__head">
          <div>
            <h1 class="schedule-page__title">График платежей</h1>
            <p class="schedule-page__conditions" data-out="conditions"></p>
          </div>
          <div class="schedule-page__actions no-print">
            <Button variant="outline" data-action="back" href="/mortgage/">Изменить условия</Button>
            <Button variant="ghost" data-action="csv">Скачать CSV</Button>
            <Button variant="ghost" data-action="print">Печать</Button>
          </div>
        </header>

        <div class="schedule-page__summary">
          <p class="figure">
            <span class="figure__label" data-out="figure-label">Ежемесячный платёж</span>
            <strong class="figure__value num" data-out="figure"></strong>
          </p>
          <dl class="stats stats--inline" data-out="stats"></dl>
        </div>

        <ScheduleTable scroll={false} />

        <section class="schedule-page__years" aria-labelledby="years-heading">
          <h2 class="schedule-page__subheading" id="years-heading">Итоги по годам</h2>
          <div class="table-wrap">
            <table class="table table--years">
              <thead>
                <tr>
                  <th scope="col">Год</th>
                  <th scope="col">Выплачено</th>
                  <th scope="col">Основной долг</th>
                  <th scope="col">Проценты</th>
                  <th scope="col">Остаток долга</th>
                </tr>
              </thead>
              <tbody data-out="years-body"></tbody>
            </table>
          </div>
        </section>
      </div>
    </section>
  </Container>
</BaseLayout>

<script>
  import { initSchedulePage } from '@/lib/schedule-ui';
  document.querySelectorAll<HTMLElement>('[data-schedule-page]').forEach(initSchedulePage);
</script>

<style>
  .schedule-page__content {
    display: grid;
    gap: var(--space-6);
  }

  .schedule-page__head {
    display: grid;
    gap: var(--space-4);
  }

  .schedule-page__title {
    font-size: var(--text-2xl);
  }

  .schedule-page__conditions {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .schedule-page__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .schedule-page__summary {
    display: grid;
    gap: var(--space-5);
    align-items: start;
  }

  .schedule-page__error {
    padding: var(--space-5);
    border-radius: var(--radius-md);
    background: var(--color-danger-soft);
    color: var(--color-danger);
  }

  .schedule-page__years {
    display: grid;
    gap: var(--space-3);
  }

  .schedule-page__subheading {
    font-size: var(--text-lg);
  }

  .figure {
    display: grid;
    gap: var(--space-1);
  }

  .figure__label {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .figure__value {
    font-size: var(--text-figure);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  @media (min-width: 768px) {
    .schedule-page__head {
      grid-template-columns: 1fr auto;
      align-items: start;
    }

    .schedule-page__summary {
      grid-template-columns: auto 1fr;
    }
  }
</style>
